{
  "expo": {
    "name": "Sportstyle",
    "slug": "Sportstyle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.albertoriesgo.sportstyle",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.albertoriesgo.sportstyle",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Sportstyle necesita acceso a la cámara para fotografiar tu outfit deportivo y puntuarlo.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sportstyle necesita acceso a tus fotos para que puedas subir una imagen de tu outfit deportivo.",
          "cameraPermission": "Sportstyle necesita acceso a la cámara para fotografiar tu outfit deportivo y puntuarlo.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
